{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Build & Run",
            "type": "coreclr",
            "request": "launch",
            "program": "${workspaceFolder}/../../RimWorld",
            "cwd": "${workspaceFolder}/../../",
            "console": "internalConsole",
            "internalConsoleOptions": "neverOpen",
            "justMyCode": true,
            "symbolOptions": {
                "searchPaths": ["${workspaceFolder}/1.7/Assemblies"],
                "searchMicrosoftSymbolServer": false
            },
            "windows": {
                "program": "${workspaceFolder}/../../RimWorld.exe",
                "preLaunchTask": "BuildWindowsDLL",
            },
            "linux": {
                "program": "${workspaceFolder}/../../RimWorld",
                "preLaunchTask": "BuildLinuxDLL",
            }
        },
    ],
}
